# ============================================================================
# Frontend Configuration
# ============================================================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE=http://localhost:8000
VITE_API_WS=ws://localhost:8000/ws/threats

# ============================================================================
# Backend API Keys (REQUIRED)
# ============================================================================

# Google Fact Check API Key
# Get one at: https://console.cloud.google.com/apis/credentials
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# GNews API Key (Primary news provider)
# Get one at: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here

# NewsAPI Key (Fallback news provider when GNews quota exceeded)
# Get one at: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# Google Gemini API Key (for LLM verification and embeddings)
# Get one at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Optional: Advanced Features
# ============================================================================

# Gemini Model Selection (default: gemini-1.5-flash)
GEMINI_MODEL_NAME=gemini-1.5-flash

# Enable stance detection using transformers (requires pip install transformers torch)
ENABLE_STANCE_DETECTION=false

# Enable Gemini embeddings for vector search
ENABLE_GEMINI_EMBEDDINGS=false

# Enable database caching (default: true)
USE_DATABASE_CACHE=true

# Enable sandbox stress testing mode (default: false)
SANDBOX_MODE=false  