# ============================================================================
# Filtr Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control!

# ============================================================================
# Frontend Configuration
# ============================================================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE=http://localhost:8000
VITE_API_WS=ws://localhost:8000/ws/threats

# ============================================================================
# Backend API Keys (REQUIRED)
# ============================================================================

# Google Fact Check API Key
# Get one at: https://console.cloud.google.com/apis/credentials
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# GNews API Key
# Get one at: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here

# Google Gemini API Key (for LLM verification and embeddings)
# Get one at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Optional: Advanced Features
# ============================================================================

# Gemini Model Selection (default: gemini-1.5-flash)
GEMINI_MODEL_NAME=gemini-1.5-flash

# Enable stance detection using transformers (requires pip install transformers torch)
# Set to "true" to enable, "false" to disable (default: false)
ENABLE_STANCE_DETECTION=false

# Enable Gemini embeddings for vector search (default: false)
ENABLE_GEMINI_EMBEDDINGS=false

# ============================================================================
# Optional: Vector Database (Pinecone)
# ============================================================================

# Pinecone Configuration (for advanced semantic search)
# Get API key at: https://www.pinecone.io/
ENABLE_PINECONE=false
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=aletheia

# ============================================================================
# Optional: Graph Database (Neo4j)
# ============================================================================

# Neo4j Configuration (for knowledge graph features)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ============================================================================
# Development/Testing
# ============================================================================

# Enable sandbox stress testing mode (default: false)
SANDBOX_MODE=false
