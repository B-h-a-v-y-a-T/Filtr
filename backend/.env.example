# ============================================================================
# Filtr Backend Environment Configuration
# ============================================================================
# This file can be placed in the backend/ directory for backend-specific config
# Backend will load both root .env and backend/.env if present

# ============================================================================
# Required API Keys
# ============================================================================

# Google Fact Check API Key
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# GNews API Key
GNEWS_API_KEY=your_gnews_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Optional Configuration
# ============================================================================

# Gemini Model (default: gemini-1.5-flash)
GEMINI_MODEL_NAME=gemini-1.5-flash

# Enable stance detection (requires transformers + torch)
ENABLE_STANCE_DETECTION=false

# Enable Gemini embeddings
ENABLE_GEMINI_EMBEDDINGS=false

# Pinecone vector database
ENABLE_PINECONE=false
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=aletheia

# Neo4j graph database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Development
SANDBOX_MODE=false

# Database caching (24-hour TTL)
USE_DATABASE_CACHE=true
